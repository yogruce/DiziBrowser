<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:orientation="vertical"
    android:background="#0D1117"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Üst Araç Çubuğu (Kumanda Dostu) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="6dp"
        android:background="#161B22"
        android:layout_width="match_parent"
        android:layout_height="54dp">

        <Button
            android:id="@+id/backButton"
            android:text="⬅ Geri"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/tv_button_bg"
            android:paddingHorizontal="8dp"
            android:layout_marginEnd="4dp"
            android:layout_width="wrap_content"
            android:layout_height="40dp" />

        <Button
            android:id="@+id/homeButton"
            android:text="🏠 Ana Ekran"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/tv_button_bg"
            android:paddingHorizontal="8dp"
            android:layout_marginEnd="4dp"
            android:layout_width="wrap_content"
            android:layout_height="40dp" />

        <EditText
            android:id="@+id/addressBar"
            android:singleLine="true"
            android:inputType="textUri"
            android:imeOptions="actionGo"
            android:hint="Site adresi veya dizi adı yazın..."
            android:textColor="#FFFFFF"
            android:textColorHint="#8B949E"
            android:textSize="13sp"
            android:paddingHorizontal="10dp"
            android:background="@drawable/tv_button_bg"
            android:layout_marginEnd="4dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp" />

        <Button
            android:id="@+id/goButton"
            android:text="Git"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/tv_button_bg"
            android:paddingHorizontal="10dp"
            android:layout_marginEnd="4dp"
            android:layout_width="wrap_content"
            android:layout_height="40dp" />

        <Button
            android:id="@+id/cursorButton"
            android:text="🖱️ İmleç: Açık"
            android:textSize="11sp"
            android:textColor="#00E5FF"
            android:background="@drawable/tv_button_bg"
            android:paddingHorizontal="8dp"
            android:layout_marginEnd="4dp"
            android:layout_width="wrap_content"
            android:layout_height="40dp" />

        <Button
            android:id="@+id/autoNextButton"
            android:text="⏭️ Oto-Bölüm: Yok"
            android:textSize="11sp"
            android:textColor="#8B949E"
            android:background="@drawable/tv_button_bg"
            android:paddingHorizontal="8dp"
            android:layout_marginEnd="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="40dp" />

        <Button
            android:id="@+id/watchPartyButton"
            android:text="👥 Birlikte İzle"
            android:textSize="11sp"
            android:textColor="#D2A8FF"
            android:background="@drawable/tv_button_bg"
            android:paddingHorizontal="8dp"
            android:layout_marginEnd="4dp"
            android:layout_width="wrap_content"
            android:layout_height="40dp" />

        <Button
            android:id="@+id/favButton"
            android:text="⭐ Favori"
            android:textSize="11sp"
            android:textColor="#FFD700"
            android:background="@drawable/tv_button_bg"
            android:paddingHorizontal="8dp"
            android:layout_marginEnd="4dp"
            android:layout_width="wrap_content"
            android:layout_height="40dp" />

        <Button
            android:id="@+id/historyButton"
            android:text="🕘 Geçmiş"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/tv_button_bg"
            android:paddingHorizontal="8dp"
            android:layout_marginEnd="4dp"
            android:layout_width="wrap_content"
            android:layout_height="40dp" />

        <Button
            android:id="@+id/qrButton"
            android:text="📱 Telefondan"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/tv_button_bg"
            android:paddingHorizontal="8dp"
            android:layout_marginEnd="4dp"
            android:layout_width="wrap_content"
            android:layout_height="40dp" />

        <Button
            android:id="@+id/updateButton"
            android:text="🔄 Güncelle"
            android:textSize="11sp"
            android:textColor="#7EE787"
            android:background="@drawable/tv_button_bg"
            android:paddingHorizontal="8dp"
            android:layout_width="wrap_content"
            android:layout_height="40dp" />
    </LinearLayout>

    <!-- Ana İçerik ve Sanal İmleç Katmanı -->
    <FrameLayout
        android:id="@+id/mainStack"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/contentHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- HTML5 Tam Ekran Video Konteyneri -->
        <FrameLayout
            android:id="@+id/fullscreenContainer"
            android:visibility="gone"
            android:background="#000000"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Netflix Tarzı Sonraki Bölüm Geri Sayım ve Hızlı Geçiş Kartı (Tam Ekranda da En Üstte Çıkar) -->
        <LinearLayout
            android:id="@+id/netflixNextCard"
            android:orientation="vertical"
            android:background="@drawable/tv_button_bg"
            android:padding="16dp"
            android:layout_gravity="top|end"
            android:layout_marginEnd="28dp"
            android:layout_marginTop="24dp"
            android:elevation="28dp"
            android:visibility="gone"
            android:layout_width="360dp"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/netflixNextTitle"
                android:text="⏭️ SIRADAKİ BÖLÜM HAZIR"
                android:textColor="#00E5FF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/netflixNextSubtitle"
                android:text="Bölüm sonuna yaklaşıldığında otomatik geçilir"
                android:textColor="#E6FFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/netflixPlayNextBtn"
                    android:text="▶ Sonraki Bölüme Geç"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/tv_button_bg"
                    android:paddingHorizontal="14dp"
                    android:layout_marginEnd="8dp"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="38dp" />

                <Button
                    android:id="@+id/netflixCancelNextBtn"
                    android:text="İptal"
                    android:textSize="11sp"
                    android:textColor="#FF7B72"
                    android:background="@drawable/tv_button_bg"
                    android:paddingHorizontal="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- D-Pad Sanal Fare İmleci Katmanı (Her zaman en üstte) -->
        <com.dizibrowser.tv.CursorOverlayView
            android:id="@+id/cursorOverlay"
            android:elevation="30dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Tam Ekran veya Video Sırasında Görünebilen Hızlı İmleç Kapatma/Açma Rozeti -->
        <TextView
            android:id="@+id/floatingCursorHint"
            android:text="🖱️ İmleci Kapatmak/Açmak için: OK tuşuna basılı tutun (1 sn)"
            android:textColor="#E6FFFFFF"
            android:textSize="11sp"
            android:background="#AA161B22"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:elevation="32dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </FrameLayout>

    <!-- Alt Bilgi ve Güvenlik Durum Çubuğu -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="#161B22"
        android:layout_width="match_parent"
        android:layout_height="28dp">

        <TextView
            android:id="@+id/statusBar"
            android:text="🛡️ Kalkan Aktif • OK Basılı Tut: İmleç Aç/Kapat • En alta inince sayfa kayar"
            android:textColor="#8B949E"
            android:textSize="11sp"
            android:singleLine="true"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/blockedCounterText"
            android:text="🚫 Engellenen: 0"
            android:textColor="#FF7B72"
            android:textSize="11sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

</LinearLayout>
